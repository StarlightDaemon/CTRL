{
  "name": "ctrl-extension",
  "displayName": "CTRL - Torrent Control",
  "description": "Torrent Control Reloaded - Modern Torrent Management",
  "private": true,
  "license": "MIT",
  "version": "0.2.0-beta.1",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "clean": "rm -rf builds/ .wxt/",
    "build": "npm run clean && npm run build:chrome && npm run build:firefox",
    "build:chrome": "wxt build -b chrome",
    "build:firefox": "wxt build -b firefox --mv3",
    "build-for-amo": "npm run zip:firefox",
    "zip": "wxt zip",
    "zip:chrome": "wxt zip -b chrome",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "zip:source": "node scripts/zip-source.ts",
    "compile": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "live:env": "node tests/live/env.mjs",
    "live:verify": "node tests/live/verify.mjs",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@carbon/icons-react": "^11.74.0",
    "@carbon/react": "^1.100.0",
    "@carbon/styles": "^1.99.0",
    "@tanstack/react-virtual": "3.13.12",
    "clsx": "2.1.1",
    "lucide-react": "0.555.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "tailwind-merge": "3.4.0",
    "txml": "5.2.1",
    "zod": "3.23.8",
    "zustand": "5.0.9"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@playwright/test": "1.57.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/chrome": "0.2.2",
    "@types/node": "26.1.0",
    "@types/react": "18.2.0",
    "@types/react-dom": "18.2.0",
    "@vitejs/plugin-react": "5.2.0",
    "@webext-core/fake-browser": "1.3.2",
    "@wxt-dev/module-react": "1.1.5",
    "autoprefixer": "10.4.19",
    "eslint": "9.39.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "globals": "17.0.0",
    "jsdom": "29.1.1",
    "postcss": "^8.5.18",
    "puppeteer-core": "25.10.0",
    "selenium-webdriver": "4.49.0",
    "sharp": "0.35.4",
    "tailwindcss": "3.4.3",
    "tsx": "4.21.0",
    "typescript": "5.7.2",
    "typescript-eslint": "8.52.0",
    "vitest": "4.1.11",
    "wxt": "0.20.27"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "fx-runner": "1.5.0",
    "web-ext-run": {
      "tmp": "0.2.7"
    },
    "node-notifier": {
      "uuid": "11.1.1"
    },
    "shell-quote": "1.9.0",
    "adm-zip": "0.6.1",
    "immutable": "5.1.8"
  }
}
